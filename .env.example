# Local dev: a Postgres running on your machine.
# Production: paste Neon's POOLED connection string (the host contains "-pooler").
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gpoints

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Friends need this to sign up, so randoms can't join off the internet.
INVITE_CODE=change-me

# Neutral accepts needed to carry a proposal. 3 needs 5+ members to ever pass;
# drop to 2 if the group is small.
VOTES_REQUIRED=3

# Whoever signs up with one of these usernames becomes admin automatically.
ADMIN_USERNAMES=nick

# Timezone for week/month/year boundaries. Weeks end Sunday 12:00 AM in this zone.
APP_TZ=America/Toronto

PORT=5000

# Optional. Discord posts when a proposal opens, lands, or is reversed.
# Discord -> Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
# Leave blank to turn notifications off entirely.
DISCORD_WEBHOOK_URL=

# Your live URL, so Discord messages can link straight to the voting page.
APP_URL=

# --- Voting from Discord (optional) ---
# A webhook can only post. To vote from Discord you need a Discord APPLICATION:
#   discord.com/developers/applications -> New Application
#   Bot tab      -> Reset Token -> copy it here
#   General tab  -> copy the Public Key
#   Right-click your channel in Discord (Developer Mode on) -> Copy Channel ID
#   General tab  -> Interactions Endpoint URL = https://YOUR-SITE/api/discord/interactions
# Invite the bot with scope=bot and the Send Messages permission.
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_CHANNEL_ID=

# Voting in the app turns OFF automatically once the three above are set.
# Force it either way with on / off.
APP_VOTING=
